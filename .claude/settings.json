{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/garde_fou.py"],
            "onFailure": "block",
            "timeout": 300
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/garde_fou.py"],
            "onFailure": "block",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
